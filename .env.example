# Environment Variables Example for GoldenCare / CareCompanion AI
# Rename this file to .env or configure in your deployment platform

# App Configuration
APP_ENV=development
APP_NAME=GoldenCare
DATABASE_PATH=data/carecompanion.db

# Passcode Configuration (Defaults)
ELDERLY_PASSCODE=1234
CARETAKER_PASSCODE=8888

# SMTP Email Alert Service Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-alert-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
ALERT_SENDER_NAME=GoldenCare Alert System
ALERT_EMAIL_RECIPIENT=caretaker@example.com
