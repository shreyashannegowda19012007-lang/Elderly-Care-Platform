# Streamlit Secrets Template (.streamlit/secrets.toml)
# Copy this file to .streamlit/secrets.toml for local credentials or paste into Streamlit Cloud Secrets

[app]
timezone = "UTC" # e.g. "America/New_York", "Europe/London", "Asia/Kolkata"

[auth]
elderly_passcode = "1234"
caretaker_passcode = "8888"

# Google Services: Google Mail / Gmail SMTP Gateway (Port 587 with TLS)
[smtp]
server = "smtp.gmail.com"
port = 587
use_tls = true
username = "your-email@gmail.com"
password = "your-app-password" # Generate in Google Account -> Security -> App Passwords
sender_name = "GoldenCare Alerts"
alert_recipient = "caretaker@example.com"

# Optional Google Cloud / Firebase Telemetry Sync
[google]
smtp_server = "smtp.gmail.com"
smtp_port = 587
use_tls = true
gmail_user = "your-email@gmail.com"
gmail_app_password = "your-app-password"
sender_name = "GoldenCare Alerts"
alert_recipient = "caretaker@example.com"
firebase_project_id = "" # Optional Firebase project ID
